+            radius: pulse ? 16 : 9,
+            y: 3
+        )
+        .onAppear { updatePulse() }
+        .onChange(of: isEnabled) { _, _ in updatePulse() }
+        .onChange(of: motionDisabled) { _, _ in updatePulse() }
