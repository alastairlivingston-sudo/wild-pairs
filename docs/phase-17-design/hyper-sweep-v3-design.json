{
  "project": "Solo",
  "engineName": "Wild Pairs",
  "styleDirection": "Hyper Sweep V3 quality-lock rebuild",
  "cardAspectRatio": "2:3",
  "masterCardPixels": {
    "width": 900,
    "height": 1350
  },
  "designGoals": [
    "Preserve ranked concept #1 instead of flattening into a system diagram.",
    "Cards should feel like real printed/lacquered production cards with laminated white rims, molded bevels and raised ink/foil marks.",
    "Every face uses a single dominant hero mark and mirrored corner indices in two opposite corners.",
    "No caption text appears on card faces; numerals and symbolic marks only."
  ],
  "visualTokens": {
    "outerRim": "warm white laminated plastic/print border with bevel shadow",
    "innerField": "saturated colour gradient with diagonal hyper sweep bands, one gloss sheen and colour-blind pattern overlay",
    "centreMark": "large raised white-to-silver slab mark, black keyline, dark extrusion offset down-right, soft cast shadow",
    "cornerIndex": "miniature raised mark plus suit symbol, mirrored top-left/bottom-right",
    "wildCards": "charcoal/black stock with four-chip motif; never represented by one colour only",
    "patterns": {
      "fire": "45 degree diagonal hatching",
      "rain": "horizontal lines",
      "earth": "vertical lines",
      "wind": "dot grid"
    },
    "colours": {
      "fire": "#E8431F",
      "rain": "#1B5FD9",
      "earth": "#2F8F5B",
      "wind": "#C9A227",
      "wild": "#111114"
    }
  },
  "actions": {
    "skip": "one player token inside a no-entry strike ring",
    "skip_two": "two struck player tokens side by side plus a small x2",
    "reverse": "two chunky arrows chasing each other in a circle",
    "draw_two": "large raised +2 hero mark",
    "targeted_draw": "one highlighted player token in a reticle, two grey side tokens, small +2",
    "forced_swap": "two hand-of-cards shapes trade along straight opposing arrows",
    "team_play": "two linked player tokens, each with a small card, small +1",
    "colour_burst": "three same-colour cards swept away by one ejection arrow",
    "change_colour": "four colour chips arranged in a rosette on a faint ring",
    "draw_four": "four-colour chips with large +4",
    "discard_all": "wild stack of cards ejecting outward along one bold arrow"
  },
